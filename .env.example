# This lab's own settings, beside docker-compose.yml. Copy to .env (mode 600, gitignored) to turn Real on.
# Names only: no value ships here. Mock needs none of this and works fully offline.
# Never ~/Documents, never ~/Development/.env: this lab reads only the .env next to its compose file.

# PORT must be 7833 (this app's one allocated port).
# PORT=7833
# Loopback only unless you set this on purpose (the Docker image sets PGC_BIND=0.0.0.0; compose publishes 127.0.0.1 only).
# PGC_BIND=
# Start mode: mock or real. Empty (the default) = Real when it is configured, else Mock.
# MODE=
# Extra Host names this lab answers to (comma separated), for example the shared lab-proxy's name for it.
# LAB_ALLOWED_HOSTS=
# The shelf (launcher) URL for the header link.
# SHELF_URL=

# --- Real mode: the Privilege gateway (owner-run; agents never use live credentials) ---
# The gateway origin (https; http only on loopback). A door is <origin>/<door>/mcp.
# PGC_GW_URL=https://gateway.example
# The door names, comma separated (lowercase letters, digits, dashes).
# PGC_GW_APPS=demo-all-tools,demo-some-tools,demo-blocked
# One agent access key per door. Write-only: never returned, logged, traced or shown.
# PGC_GW_KEY_DEMO_ALL_TOOLS=
# PGC_GW_KEY_DEMO_SOME_TOOLS=
# PGC_GW_KEY_DEMO_BLOCKED=
# Optional operator label for the gateway version (letters, digits, . _ + -).
# PGC_GW_VERSION=
# Optional: who the keys act as, shown as "identity declared by this lab's settings" (letters, digits, . _ @ + -). A real 401/403 names no identity, so the lab shows only what you declare here.
# PGC_GW_IDENTITY=

# --- Demo settings (rules 10 to 13) ---
# Mock sign-in (the persona picker aidemo / demouser / demoAdmin) is on only when BOTH IDP=mock and ALLOW_MOCK_SIGNIN=1 are set
# (the compose file sets them, because it publishes on 127.0.0.1 only). It is refused behind a proxy and on a non-loopback bind.
# IDP=
# ALLOW_MOCK_SIGNIN=
# The compose file sets this to the word loopback because it publishes 127.0.0.1 only: the marker the sign-in guard reads. Do not set it elsewhere.
# LAB_PUBLISH=
# Open the page in presenter mode (the talk track opens, the chrome steps back). ?presenter=1 does the same for one visit.
# PGC_PRESENTER=
# Where a workspace keeps files (its trace sink). Empty = memory only.
# PGC_DATA_DIR=
# Signs the sign-in cookie. Empty = a random secret per start (sessions end with the process).
# PGC_SESSION_SECRET=
# Path of a customer.config.json (branding and vocabulary). Default: customer.config.json beside package.json, if it exists.
# CUSTOMER_CONFIG=

# --- Real mode: pi.flow page sign-in (no redirect login). The password is typed in the sign-in dialog and never stored here. ---
# The PingOne environment id and its region (com, eu, ca, asia, com.au or sg; default com).
# PGC_PINGONE_ENVIRONMENT_ID=
# PGC_PINGONE_REGION=
# A public OIDC web app in that environment with response mode pi.flow allowed and the authorization code grant. No secret is used.
# PGC_USER_CLIENT_ID=
# Optional: the redirect URI registered on that app (https, or http on loopback). Never visited: pi.flow does not redirect. Default http://127.0.0.1:7833/callback
# PGC_USER_REDIRECT_URI=
